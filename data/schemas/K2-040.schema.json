{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/K2-040.schema.json",
  "title": "K2-040 väljundi struktuur",
  "type": "object",
  "properties": {
    "kohtumised": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "isik": {
            "type": [
              "string",
              "null"
            ]
          },
          "kuupäev": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "isik",
          "kuupäev"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kohtumised"
  ],
  "additionalProperties": false
}
