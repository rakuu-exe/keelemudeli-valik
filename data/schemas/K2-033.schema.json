{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/K2-033.schema.json",
  "title": "K2-033 väljundi struktuur",
  "type": "object",
  "properties": {
    "ettemaks": {
      "type": [
        "number",
        "null"
      ]
    },
    "tähtaeg": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "viitenumber": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "ettemaks",
    "tähtaeg",
    "viitenumber"
  ],
  "additionalProperties": false
}
